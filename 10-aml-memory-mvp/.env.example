AML_DATABASE_PATH=data/memory.db
AML_LLM_MODE=best_effort
AML_API_KEY=
AML_CANDIDATE_LIMIT=400
AML_MAX_OUTPUT_CHARS=240000

# The enhanced formal configuration uses the AML-permitted gpt-4o-mini model.
# Use a dedicated project capped at USD 50 and inject the credential at runtime;
# never commit it. best_effort remains deterministic and available without one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
