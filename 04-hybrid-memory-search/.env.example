# 复制为本目录下的 .env 后填写真实值，再启动容器：
#   cp .env.example .env

# ---------- Embedding（add / search 必填）----------
OPENAI_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_API_KEY=sk-your-embedding-key
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIMENSIONS=1024

# ---------- Hybrid 检索 ----------
# score = α * bm25_norm + (1-α) * dense_norm
HYBRID_ALPHA=0.5

# 记忆落盘目录；docker-compose 会覆盖为容器内 /app/store
MEMORY_STORE_DIR=store

# 主机映射端口：http://<主机>:<PORT>
PORT=8000

# ---------- 以下可选，add/search 不依赖 ----------
# Chat LLM（若后续接生成答案再用）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini
