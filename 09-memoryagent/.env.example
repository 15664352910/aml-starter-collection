# 复制为 .env 后按需修改。所有变量都有默认值，不配置也能跑。

# 认证密钥：设置后所有 /aml/* 请求必须带 Authorization: Bearer <key>
# 参赛时生成一个长随机串，通过安全渠道提交给平台，不要提交进 git
AML_MEMORY_SYSTEM_KEY=

# 向量后端：st（sentence-transformers，推荐）| hash（零依赖演示/测试）
EMBEDDING_BACKEND=st
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 存储路径（docker 中为 /app/chroma_data）
MEMORY_DB_PATH=./chroma_data

# 写入去重阈值（余弦相似度，0~1）；0.95 表示几乎重复才丢弃，1.0 关闭
DEDUP_THRESHOLD=0.95

# 弃权阈值：低于该得分的结果丢弃并返回空数组。默认 0.0 不弃权
ABSTENTION_THRESHOLD=0.0
